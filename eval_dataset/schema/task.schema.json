{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.schema.json",
  "title": "ReproAgent evaluation task",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "title",
    "category",
    "source_kind",
    "paper_path",
    "repository_path",
    "target_experiment",
    "run",
    "inputs",
    "resources",
    "budget"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "case_id": {"type": "string", "pattern": "^case_[0-9]{3}_[a-z0-9_]+$"},
    "title": {"type": "string", "minLength": 1},
    "category": {"enum": ["direct", "repair", "gap", "blocked", "invalid_input"]},
    "source_kind": {"enum": ["real_workspace", "synthetic"]},
    "paper_path": {"type": "string", "minLength": 1},
    "repository_path": {"type": "string", "minLength": 1},
    "target_experiment": {"type": "string", "minLength": 1},
    "run": {
      "type": "object",
      "required": ["working_directory", "command", "metrics_output_path", "expected_artifacts"],
      "properties": {
        "working_directory": {"type": "string"},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "metrics_output_path": {"type": ["string", "null"]},
        "expected_artifacts": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "required": ["dataset_paths", "model_paths", "checkpoint_paths"],
      "properties": {
        "dataset_paths": {"type": "array", "items": {"type": "string"}},
        "model_paths": {"type": "array", "items": {"type": "string"}},
        "checkpoint_paths": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "intentionally_missing_paths": {"type": "array", "items": {"type": "string"}},
    "resources": {"type": "object"},
    "budget": {
      "type": "object",
      "required": ["max_runtime_seconds"],
      "properties": {"max_runtime_seconds": {"type": "integer", "minimum": 1}}
    },
    "known_challenge": {"type": "string"}
  },
  "additionalProperties": false
}
